{
  "name": "hpen-remaster",
  "version": "0.1.0",
  "private": true,
  "description": "Windows live magnifier and annotation prototype",
  "author": "hiphop5782",
  "engines": { "node": ">=22.12.0" },
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "setup": "node node_modules/electron/install.js",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/build.mjs && electron-builder --win --x64 --dir",
    "build:portable": "node scripts/build.mjs && electron-builder --win portable --x64",
    "build:installer": "node scripts/build.mjs && electron-builder --win nsis --x64",
    "build:win": "node scripts/build.mjs && electron-builder --win portable nsis --x64"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
